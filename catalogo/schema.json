{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caduceus PS2 art game manifest v1",
  "type": "object",
  "required": ["id", "cover", "disc", "background", "backgrounds", "alternatives", "extras"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9]{4}_[0-9]{3}\\.[0-9]{2}$"},
    "cover": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/asset"}]},
    "disc": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/asset"}]},
    "background": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/asset"}]},
    "backgrounds": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "extras": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "alternatives": {
      "type": "object",
      "required": ["covers", "discs"],
      "properties": {
        "covers": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "discs": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["path", "kind", "bytes", "width", "height", "sha256", "source"],
      "properties": {
        "path": {"type": "string", "pattern": "^(PS2|originais|extras)/"},
        "kind": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source": {"type": "object", "required": ["id"]},
        "gameId": {"type": "string"}
      }
    }
  }
}
